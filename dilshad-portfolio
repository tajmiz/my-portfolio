  <script>
    (function() {
      'use strict';

      // --- Theme Toggler & Persistence ---
      var root = document.documentElement;
      var themeBtn = document.getElementById('themeBtn');
      var themeText = document.getElementById('themeText');
      var savedTheme = localStorage.getItem('taj_portfolio_theme');

      if (savedTheme) {
        root.setAttribute('data-theme', savedTheme);
        updateThemeLabel(savedTheme);
      }

      function updateThemeLabel(theme) {
        var isDark = theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
        themeText.textContent = isDark ? 'Light' : 'Dark';
      }

      themeBtn.addEventListener('click', function() {
        var current = root.getAttribute('data-theme');
        if (!current) {
          current = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        var next = current === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        localStorage.setItem('taj_portfolio_theme', next);
        updateThemeLabel(next);
        showToast('Switched to ' + next + ' theme');
      });

      // --- Official Executive CV Download (Updated PDF attached) ---
      // The Download CV button is configured with the official 3-page Executive PDF CV embedded directly as Base64 data.

      // --- Toast Notification Helper ---
      var toast = document.getElementById('toast');
      var toastTimer;
      function showToast(msg) {
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function() {
          toast.classList.remove('show');
        }, 2200);
      }

      // --- Clipboard Copy Handlers ---
      var copyButtons = document.querySelectorAll('[data-copy]');
      copyButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var text = btn.getAttribute('data-copy');
          if (!text) return;

          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(function() {
              showToast('Copied: ' + text);
            }).catch(function() {
              fallbackCopy(text);
            });
          } else {
            fallbackCopy(text);
          }
        });
      });

      function fallbackCopy(text) {
        var tempInput = document.createElement('input');
        tempInput.value = text;
        document.body.appendChild(tempInput);
        tempInput.select();
        try {
          document.execCommand('copy');
          showToast('Copied: ' + text);
        } catch (err) {
          showToast('Could not copy automatically');
        }
        document.body.removeChild(tempInput);
      }

      // --- Scroll Progress Bar ---
      var progressBar = document.getElementById('progress-bar');
      window.addEventListener('scroll', function() {
        var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        var docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        var scrollPercent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        if (progressBar) {
          progressBar.style.width = scrollPercent + '%';
        }
      }, { passive: true });

      

      // --- Filter Tabs for Awards & Records ---
      var filterButtons = document.querySelectorAll('.filter-btn');
      var awardCards = document.querySelectorAll('.award-card');

      filterButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var targetFilter = btn.getAttribute('data-filter');
          filterButtons.forEach(function(b) { b.classList.remove('active'); });
          btn.classList.add('active');

          awardCards.forEach(function(card) {
            var cat = card.getAttribute('data-category');
            if (targetFilter === 'all' || cat === targetFilter) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });

      // --- Scroll Spy for Sticky Nav ---
      var navLinks = document.querySelectorAll('.nav-links a');
      var sections = [];
      navLinks.forEach(function(link) {
        var href = link.getAttribute('href');
        if (href && href.startsWith('#')) {
          var sec = document.querySelector(href);
          if (sec) sections.push({ link: link, section: sec });
        }
      });

      window.addEventListener('scroll', function() {
        var scrollPos = (window.pageYOffset || document.documentElement.scrollTop) + 120;
        sections.forEach(function(item) {
          var top = item.section.offsetTop;
          var height = item.section.offsetHeight;
          if (scrollPos >= top && scrollPos < top + height) {
            navLinks.forEach(function(l) { l.classList.remove('on'); });
            item.link.classList.add('on');
          }
        });
      }, { passive: true });

      // --- Contact Form Submission Handler ---
      var contactForm = document.getElementById('contactForm');
      if (contactForm) {
        contactForm.addEventListener('submit', function(e) {
          e.preventDefault();
          var name = document.getElementById('senderName').value;
          var email = document.getElementById('senderEmail').value;
          var subject = document.getElementById('senderSubject').value;
          var message = document.getElementById('senderMessage').value;

          var mailtoUrl = 'mailto:md929taj@gmail.com?subject=' + encodeURIComponent('[' + name + '] ' + subject) +
                          '&body=' + encodeURIComponent('Sender: ' + name + ' (' + email + ')\n\n' + message);
          
          window.location.href = mailtoUrl;
          showToast('Opening default mail client to transmit inquiry...');
        });
      }

    })();
  
      // --- Smooth Buffering Preloader ---
      var preloader = document.getElementById('sitePreloader');
      var pBar = document.getElementById('preloaderProgress');
      var pCounter = document.getElementById('preloaderCounter');
      var pMsg = document.getElementById('preloaderStatusMsg');

      var msgs = [
        "INITIALIZING QUANT ENGINE...",
        "INDEXING ECONOMETRIC PAPERS...",
        "VERIFYING CREDENTIAL LEDGER...",
        "CALIBRATING SYSTEM MODULES...",
        "PORTFOLIO READY"
      ];

      var pct = 0;
      var msgIdx = 0;
      var startTime = Date.now();
      var loadComplete = false;

      window.addEventListener('load', function() {
        loadComplete = true;
      });

      var preloaderInterval = setInterval(function() {
        if (!loadComplete) {
          if (pct < 88) {
            pct += Math.floor(Math.random() * 5) + 3;
            if (pct > 88) pct = 88;
          }
        } else {
          pct += Math.floor(Math.random() * 10) + 8;
          if (pct >= 100) {
            pct = 100;
            clearInterval(preloaderInterval);
            setTimeout(function() {
              if (preloader) {
                preloader.classList.add('loaded');
                setTimeout(function() {
                  preloader.style.display = 'none';
                }, 650);
              }
            }, 250);
          }
        }

        if (pBar) pBar.style.width = pct + '%';
        if (pCounter) pCounter.textContent = pct + '%';

        var targetMsgIdx = Math.min(Math.floor((pct / 100) * msgs.length), msgs.length - 1);
        if (targetMsgIdx !== msgIdx && pMsg) {
          msgIdx = targetMsgIdx;
          pMsg.textContent = msgs[msgIdx];
        }
      }, 35);

      setTimeout(function() {
        if (preloader && !preloader.classList.contains('loaded')) {
          if (pBar) pBar.style.width = '100%';
          if (pCounter) pCounter.textContent = '100%';
          preloader.classList.add('loaded');
          setTimeout(function() { preloader.style.display = 'none'; }, 650);
        }
      }, 3500);

      // --- Intersection Observer for Scroll Animations ---
      if ('IntersectionObserver' in window) {
        var scrollObserver = new IntersectionObserver(function(entries, observer) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.10,
          rootMargin: '0px 0px -40px 0px'
        });

        var revealTargets = document.querySelectorAll('section.block, .research-card, .timeline-card, .skill-card, .award-card, .ref-card');
        revealTargets.forEach(function(el) {
          el.classList.add('reveal-on-scroll');
          scrollObserver.observe(el);
        });
      }
</script>

